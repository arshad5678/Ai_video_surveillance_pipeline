# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Environment
.env

# Model weights (large binaries, fetched separately)
weights/*
!weights/.gitkeep

# Data (input video artifacts, not source-controlled)
data/input/*
data/processed/*
!data/input/.gitkeep
!data/processed/.gitkeep

# OutputGenerator artifacts (annotated video, snapshots, clips, logs) --
# runtime-generated on every pipeline execution, never source-controlled.
# sample_outputs/ is the deliberate exception: a small, hand-picked,
# committed set of example artifacts for GitHub submission (see its
# README section) -- nothing under output/ is ever copied there
# automatically, and the pipeline/API never read from or write to it.
output/*
!output/.gitkeep

# Logs
logs/*
!logs/.gitkeep

# Notebooks checkpoints
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/
