# Copy to .env and fill in real values. No secrets belong in source control.

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO

# Compute
DEVICE=cpu               # cpu | cuda | mps

# Video Input — pick ONE source type and set VIDEO_SOURCE accordingly
#   webcam -> device index, e.g. 0
#   file   -> path to a local video file, e.g. data/input/sample.mp4
#   rtsp   -> stream URL, e.g. rtsp://user:pass@192.168.1.10:554/stream1
VIDEO_SOURCE_TYPE=webcam
VIDEO_SOURCE=0

# Paths (defaults align with the data/ and weights/ folders)
INPUT_DIR=data/input
PROCESSED_DIR=data/processed
WEIGHTS_DIR=weights

# API (if/when the FastAPI service is enabled)
API_HOST=0.0.0.0
API_PORT=8000

# Database (placeholder — fill in once persistence is added)
DATABASE_URL=
